        "\n",
        "# ================================================================\n",
        "# REWARD MODEL OVER-OPTIMIZATION EXPERIMENT\n",
        "# Google Colab / Python 3\n",
        "#\n",
        "# Goals:\n",
        "# 1. Train reward models with different capacities and data sizes.\n",
        "# 2. Optimize a policy against each learned reward model.\n",
        "# 3. Track learned reward vs. true human utility.\n",
        "# 4. Find the over-optimization peak.\n",
        "# 5. Diagnose reward hacking using interpretable features.\n",
        "# 6. Save plots, CSV files, and a text report.\n",
        "#\n",
        "# This is a synthetic research simulation, not a benchmark of\n",
        "# a pretrained language model or a real-world RLHF system.\n",
        "# ================================================================\n",
        "\n",
        "import os\n",
        "import random\n",
        "import json\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import DataLoader, TensorDataset\n",
        "\n",
        "# ----------------------------\n",
        "# 1. Reproducibility and device\n",
        "# ----------------------------\n",
        "\n",
        "SEED = 42\n",
        "random.seed(SEED)\n",
        "np.random.seed(SEED)\n",
        "torch.manual_seed(SEED)\n",
        "\n",
        "if torch.cuda.is_available():\n",
        "    DEVICE = torch.device(\"cuda\")\n",
        "else:\n",
        "    DEVICE = torch.device(\"cpu\")\n",
        "\n",
        "print(\"Device:\", DEVICE)\n",
        "\n",
        "OUTPUT_DIR = \"/content/reward_optimization_results\"\n",
        "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "\n",
        "# ----------------------------\n",
        "# 2. Experiment configuration\n",
        "# ----------------------------\n",
        "\n",
        "DATA_SIZES = [500, 2000, 8000]\n",
        "\n",
        "# Different hidden-layer capacities\n",
        "MODEL_SIZES = {\n",
        "    \"small\": 8,\n",
        "    \"medium\": 32,\n",
        "    \"large\": 128,\n",
        "}\n",
        "\n",
        "FEATURE_NAMES = [\n",
        "    \"genuine_quality\",\n",
        "    \"verbosity\",\n",
        "    \"keyword_stuffing\",\n",
        "    \"repetition\",\n",
        "    \"formatting\"\n",
        "]\n",
        "\n",
        "N_FEATURES = len(FEATURE_NAMES)\n",
        "\n",
        "# Increase for more precise results; reduce for a quick test.\n",
        "EPOCHS = 35\n",
        "BATCH_SIZE = 256\n",
        "LEARNING_RATE = 1e-3\n",
        "\n",
        "POLICY_STEPS = 250\n",
        "POLICY_LR = 0.025\n",
        "\n",
        "# The quadratic penalty represents a simplified constraint that\n",
        "# discourages the policy from moving too far from the baseline.\n",
        "KL_COEFFICIENT = 0.08\n",
        "\n",
        "# ----------------------------\n",
        "# 3. Synthetic human utility\n",
        "# ----------------------------\n",
        "\n",
        "def true_utility(x):\n",
        "    \"\"\"\n",
        "    Ground-truth human utility.\n",
        "\n",
        "    x columns:\n",
        "       0: genuine quality\n",
        "       1: verbosity\n",
        "       2: keyword stuffing\n",
        "       3: repetition\n",
        "       4: formatting\n",
        "\n",
        "    High genuine quality is beneficial.\n",
        "    Excessive verbosity, keyword stuffing, and repetition hurt.\n",
        "    Clear formatting gives a modest benefit.\n",
        "\n",
        "    This is an illustrative objective, not a universal model\n",
        "    of human preferences.\n",
        "    \"\"\"\n",
        "    quality = x[..., 0]\n",
        "    verbosity = x[..., 1]\n",
        "    keyword_stuffing = x[..., 2]\n",
        "    repetition = x[..., 3]\n",
        "    formatting = x[..., 4]\n",
        "\n",
        "    utility = (\n",
        "        1.00 * quality\n",
        "        - 0.15 * verbosity\n",
        "        - 0.85 * keyword_stuffing\n",
        "        - 0.65 * repetition\n",
        "        + 0.20 * formatting\n",
        "    )\n",
        "\n",
        "    return utility\n",
        "\n",
        "\n",
        "# ----------------------------\n",
        "# 4. Generate preference data\n",
        "# ----------------------------\n",
        "\n",
        "def generate_preference_data(n_pairs, seed):\n",
        "    \"\"\"\n",
        "    Generate pairs of candidate responses.\n",
        "\n",
        "    Each pair has a preferred candidate according to latent\n",
        "    human utility, with a small amount of label noise.\n",
        "\n",
        "    Features are observable proxies for response characteristics.\n",
        "    \"\"\"\n",
        "    rng = np.random.default_rng(seed)\n",
        "\n",
        "    x_a = rng.normal(0, 1, size=(n_pairs, N_FEATURES))\n",
        "    x_b = rng.normal(0, 1, size=(n_pairs, N_FEATURES))\n",
        "\n",
        "    # Keep training features in a plausible range.\n",
        "    x_a = np.clip(x_a, -2.5, 2.5)\n",
        "    x_b = np.clip(x_b, -2.5, 2.5)\n",
        "\n",
        "    u_a = true_utility(x_a)\n",
        "    u_b = true_utility(x_b)\n",
        "\n",
        "    # Bradley-Terry-style preference probability.\n",
        "    # Noise makes preferences imperfect rather than deterministic.\n",
        "    temperature = 0.65\n",
        "    p_a_preferred = 1.0 / (\n",
        "        1.0 + np.exp(np.clip(-(u_a - u_b) / temperature, -30, 30))\n",
        "    )\n",
        "\n",
        "    labels = rng.binomial(1, p_a_preferred)\n",
        "\n",
        "    return (\n",
        "        torch.tensor(x_a, dtype=torch.float32),\n",
        "        torch.tensor(x_b, dtype=torch.float32),\n",
        "        torch.tensor(labels, dtype=torch.float32),\n",
        "    )\n",
        "\n",
        "\n",
        "# ----------------------------\n",
        "# 5. Reward model\n",
        "# ----------------------------\n",
        "\n",
        "class RewardModel(nn.Module):\n",
        "    def __init__(self, hidden_size):\n",
        "        super().__init__()\n",
        "\n",
        "        self.network = nn.Sequential(\n",
        "            nn.Linear(N_FEATURES, hidden_size),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(hidden_size, hidden_size),\n",
        "            nn.Tanh(),\n",
        "            nn.Linear(hidden_size, 1),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.network(x).squeeze(-1)\n",
        "\n",
        "\n",
        "def train_reward_model(n_pairs, hidden_size, seed):\n",
        "    \"\"\"\n",
        "    Train a reward model with pairwise preference loss.\n",
        "\n",
        "    The Bradley-Terry objective encourages the preferred response\n",
        "    to receive a higher reward than the other response.\n",
        "    \"\"\"\n",
        "    torch.manual_seed(seed)\n",
        "\n",
        "    x_a, x_b, labels = generate_preference_data(\n",
        "        n_pairs=n_pairs,\n",
        "        seed=seed + 1000\n",
        "    )\n",
        "\n",
        "    dataset = TensorDataset(x_a, x_b, labels)\n",
        "\n",
        "    generator = torch.Generator()\n",
        "    generator.manual_seed(seed)\n",
        "\n",
        "    loader = DataLoader(\n",
        "        dataset,\n",
        "        batch_size=BATCH_SIZE,\n",
        "        shuffle=True,\n",
        "        generator=generator\n",
        "    )\n",
        "\n",
        "    model = RewardModel(hidden_size).to(DEVICE)\n",
        "\n",
        "    optimizer = torch.optim.Adam(\n",
        "        model.parameters(),\n",
        "        lr=LEARNING_RATE,\n",
        "        weight_decay=1e-5\n",
        "    )\n",
        "\n",
        "    for epoch in range(EPOCHS):\n",
        "        model.train()\n",
        "        total_loss = 0.0\n",
        "        total_n = 0\n",
        "\n",
        "        for xa, xb, y in loader:\n",
        "            xa = xa.to(DEVICE)\n",
        "            xb = xb.to(DEVICE)\n",
        "            y = y.to(DEVICE)\n",
        "\n",
        "            ra = model(xa)\n",
        "            rb = model(xb)\n",
        "\n",
        "            # log sigmoid of reward difference, with label y:\n",
        "            # y=1 means A preferred; y=0 means B preferred.\n",
        "            logits = ra - rb\n",
        "            loss = F.binary_cross_entropy_with_logits(logits, y)\n",
        "\n",
        "            optimizer.zero_grad()\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "\n",
        "            total_loss += loss.item() * len(y)\n",
        "            total_n += len(y)\n",
        "\n",
        "        if epoch in (0, 9, 19, 34):\n",
        "            print(\n",
        "                f\"    Epoch {epoch + 1:02d}/{EPOCHS}: \"\n",
        "                f\"loss={total_loss / total_n:.4f}\"\n",
        "            )\n",
        "\n",
        "    return model\n",
        "\n",
        "\n",
        "# ----------------------------\n",
        "# 6. Evaluate held-out preferences\n",
        "# ----------------------------\n",
        "\n",
        "def evaluate_reward_model(model, seed):\n",
        "    \"\"\"\n",
        "    Held-out pairwise accuracy and pairwise cross-entropy.\n",
        "    \"\"\"\n",
        "    xa, xb, labels = generate_preference_data(\n",
        "        n_pairs=2000,\n",
        "        seed=seed + 90000\n",
        "    )\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        xa = xa.to(DEVICE)\n",
        "        xb = xb.to(DEVICE)\n",
        "        labels = labels.to(DEVICE)\n",
        "\n",
        "        logits = model(xa) - model(xb)\n",
        "        loss = F.binary_cross_entropy_with_logits(logits, labels)\n",
        "        accuracy = (\n",
        "            ((logits >= 0).float() == labels).float().mean()\n",
        "        )\n",
        "\n",
        "    return float(accuracy.item()), float(loss.item())\n",
        "\n",
        "\n",
        "# ----------------------------\n",
        "# 7. Policy optimization\n",
        "# ----------------------------\n",
        "\n",
        "def optimize_policy(model, steps=POLICY_STEPS):\n",
        "    \"\"\"\n",
        "    Optimize a five-dimensional policy action against the learned\n",
        "    reward model, with a quadratic distance penalty.\n",
        "\n",
        "    Increasing policy steps increases optimization pressure.\n",
        "    This is a simplified continuous-action policy, not an LLM.\n",
        "\n",
        "    We track:\n",
        "      - learned reward\n",
        "      - true human utility\n",
        "      - individual feature values\n",
        "      - policy distance from the reference action\n",
        "    \"\"\"\n",
        "    model.eval()\n",
        "\n",
        "    # Reference/baseline policy output.\n",
        "    x = nn.Parameter(torch.zeros(1, N_FEATURES, device=DEVICE))\n",
        "\n",
        "    optimizer = torch.optim.Adam([x], lr=POLICY_LR)\n",
        "\n",
        "    history = []\n",
        "\n",
        "    for step in range(steps + 1):\n",
        "        if step > 0:\n",
        "            optimizer.zero_grad()\n",
        "\n",
        "            learned_reward = model(x).mean()\n",
        "            penalty = KL_COEFFICIENT * (x ** 2).mean()\n",
        "\n",
        "            # Maximize learned reward while limiting deviation.\n",
        "            objective = learned_reward - penalty\n",
        "\n",
        "            (-objective).backward()\n",
        "            optimizer.step()\n",
        "\n",
        "            # Bound the action space to avoid unbounded extrapolation.\n",
        "            with torch.no_grad():\n",
        "                x.clamp_(-3.0, 3.0)\n",
        "\n",
        "        if step % 5 == 0 or step == steps:\n",
        "            with torch.no_grad():\n",
        "                action = x.detach().cpu().numpy()[0]\n",
        "                reward = model(x).item()\n",
        "                utility = true_utility(\n",
        "                    x.detach()\n",
        "                ).item()\n",
        "\n",
        "                history.append({\n",
        "                    \"step\": step,\n",
        "                    \"predicted_reward\": reward,\n",
        "                    \"true_utility\": utility,\n",
        "                    \"policy_distance\": float(\n",
        "                        np.linalg.norm(action)\n",
        "                    ),\n",
        "                    **{\n",
        "                        FEATURE_NAMES[i]: float(action[i])\n",
        "                        for i in range(N_FEATURES)\n",
        "                    }\n",
        "                })\n",
        "\n",
        "    return pd.DataFrame(history)\n",
        "\n",
        "\n",
        "# ----------------------------\n",
        "# 8. Find the over-optimization peak\n",
        "# ----------------------------\n",
        "\n",
        "def summarize_run(history, model_name, hidden_size, n_pairs,\n",
        "                  heldout_accuracy, heldout_loss):\n",
        "    \"\"\"\n",
        "    Locate the step where measured true utility is highest.\n",
        "\n",
        "    A later decrease in true utility while learned reward rises\n",
        "    is evidence of reward-model over-optimization in this setup.\n",
        "    \"\"\"\n",
        "    peak_idx = history[\"true_utility\"].idxmax()\n",
        "    peak = history.loc[peak_idx]\n",
        "    final = history.iloc[-1]\n",
        "\n",
        "    # Did the final policy fall below its best observed utility?\n",
        "    utility_drop = (\n",
        "        float(peak[\"true_utility\"] - final[\"true_utility\"])\n",
        "    )\n",
        "\n",
        "    # Compare against the initial baseline.\n",
        "    baseline_utility = float(history.iloc[0][\"true_utility\"])\n",
        "\n",
        "    return {\n",
        "        \"model_size\": model_name,\n",
        "        \"hidden_units\": hidden_size,\n",
        "        \"training_pairs\": n_pairs,\n",
        "        \"heldout_accuracy\": heldout_accuracy,\n",
        "        \"heldout_loss\": heldout_loss,\n",
        "        \"peak_step\": int(peak[\"step\"]),\n",
        "        \"peak_true_utility\": float(peak[\"true_utility\"]),\n",
        "        \"baseline_true_utility\": baseline_utility,\n",
        "        \"final_true_utility\": float(final[\"true_utility\"]),\n",
        "        \"final_predicted_reward\": float(final[\"predicted_reward\"]),\n",
        "        \"peak_predicted_reward\": float(peak[\"predicted_reward\"]),\n",
        "        \"utility_drop_after_peak\": utility_drop,\n",
        "        \"overoptimization_observed\": bool(\n",
        "            utility_drop > 0.02\n",
        "            and final[\"predicted_reward\"] >\n",
        "                peak[\"predicted_reward\"]\n",
        "        ),\n",
        "        \"final_keyword_stuffing\": float(final[\"keyword_stuffing\"]),\n",
        "        \"final_repetition\": float(final[\"repetition\"]),\n",
        "        \"final_verbosity\": float(final[\"verbosity\"]),\n",
        "        \"final_genuine_quality\": float(final[\"genuine_quality\"]),\n",
        "        \"final_formatting\": float(final[\"formatting\"]),\n",
        "    }\n",
        "\n",
        "\n",
        "# ----------------------------\n",
        "# 9. Run all experiments\n",
        "# ----------------------------\n",
        "\n",
        "all_histories = {}\n",
        "summary_rows = []\n",
        "\n",
        "total_runs = len(MODEL_SIZES) * len(DATA_SIZES)\n",
        "run_number = 0\n",
        "\n",
        "for model_name, hidden_size in MODEL_SIZES.items():\n",
        "    for n_pairs in DATA_SIZES:\n",
        "        run_number += 1\n",
        "        run_seed = SEED + run_number * 101\n",
        "\n",
        "        print(\"\\n\" + \"=\" * 70)\n",
        "        print(\n",
        "            f\"Run {run_number}/{total_runs}: \"\n",
        "            f\"model={model_name}, hidden={hidden_size}, \"\n",
        "            f\"preference pairs={n_pairs}\"\n",
        "        )\n",
        "        print(\"=\" * 70)\n",
        "\n",
        "        reward_model = train_reward_model(\n",
        "            n_pairs=n_pairs,\n",
        "            hidden_size=hidden_size,\n",
        "            seed=run_seed\n",
        "        )\n",
        "\n",
        "        accuracy, heldout_loss = evaluate_reward_model(\n",
        "            reward_model,\n",
        "            seed=run_seed\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"Held-out accuracy={accuracy:.3f}, \"\n",
        "            f\"loss={heldout_loss:.3f}\"\n",
        "        )\n",
        "\n",
        "        history = optimize_policy(reward_model)\n",
        "\n",
        "        key = f\"{model_name}_data_{n_pairs}\"\n",
        "        all_histories[key] = history\n",
        "\n",
        "        history.to_csv(\n",
        "            os.path.join(OUTPUT_DIR, f\"{key}_history.csv\"),\n",
        "            index=False\n",
        "        )\n",
        "\n",
        "        summary = summarize_run(\n",
        "            history=history,\n",
        "            model_name=model_name,\n",
        "            hidden_size=hidden_size,\n",
        "            n_pairs=n_pairs,\n",
        "            heldout_accuracy=accuracy,\n",
        "            heldout_loss=heldout_loss\n",
        "        )\n",
        "\n",
        "        summary_rows.append(summary)\n",
        "\n",
        "        print(\n",
        "            f\"Peak step={summary['peak_step']}, \"\n",
        "            f\"peak utility={summary['peak_true_utility']:.3f}, \"\n",
        "            f\"final utility={summary['final_true_utility']:.3f}, \"\n",
        "            f\"utility drop={summary['utility_drop_after_peak']:.3f}\"\n",
        "        )\n",
        "\n",
        "        del reward_model\n",
        "        if torch.cuda.is_available():\n",
        "            torch.cuda.empty_cache()\n",
        "\n",
        "# ----------------------------\n",
        "# 10. Save and display summary\n",
        "# ----------------------------\n",
        "\n",
        "summary_df = pd.DataFrame(summary_rows)\n",
        "\n",
        "summary_path = os.path.join(OUTPUT_DIR, \"experiment_summary.csv\")\n",
        "summary_df.to_csv(summary_path, index=False)\n",
        "\n",
        "display_columns = [\n",
        "    \"model_size\",\n",
        "    \"training_pairs\",\n",
        "    \"heldout_accuracy\",\n",
        "    \"peak_step\",\n",
        "    \"peak_true_utility\",\n",
        "    \"final_true_utility\",\n",
        "    \"utility_drop_after_peak\",\n",
        "    \"overoptimization_observed\"\n",
        "]\n",
        "\n",
        "print(\"\\nEXPERIMENT SUMMARY\")\n",
        "display(\n",
        "    summary_df[display_columns].sort_values(\n",
        "        [\"model_size\", \"training_pairs\"]\n",
        "    ).reset_index(drop=True)\n",
        ")\n",
        "\n",
        "# ----------------------------\n",
        "# 11. Plot predicted reward vs true utility\n",
        "# ----------------------------\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
        "\n",
        "for key, history in all_histories.items():\n",
        "    axes[0].plot(\n",
        "        history[\"step\"],\n",
        "        history[\"predicted_reward\"],\n",
        "        label=key\n",
        "    )\n",
        "    axes[1].plot(\n",
        "        history[\"step\"],\n",
        "        history[\"true_utility\"],\n",
        "        label=key\n",
        "    )\n",
        "\n",
        "axes[0].set_title(\"Learned Reward During Policy Optimization\")\n",
        "axes[0].set_xlabel(\"Policy optimization step\")\n",
        "axes[0].set_ylabel(\"Predicted reward\")\n",
        "axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "axes[1].set_title(\"True Utility During Policy Optimization\")\n",
        "axes[1].set_xlabel(\"Policy optimization step\")\n",
        "axes[1].set_ylabel(\"True human utility\")\n",
        "axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "axes[0].legend(fontsize=7, loc=\"best\")\n",
        "axes[1].legend(fontsize=7, loc=\"best\")\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "curve_path = os.path.join(\n",
        "    OUTPUT_DIR, \"reward_vs_true_utility.png\"\n",
        ")\n",
        "plt.savefig(curve_path, dpi=160, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "# ----------------------------\n",
        "# 12. Plot where the peak moves\n",
        "# ----------------------------\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "\n",
        "for model_name in MODEL_SIZES:\n",
        "    subset = summary_df[\n",
        "        summary_df[\"model_size\"] == model_name\n",
        "    ].sort_values(\"training_pairs\")\n",
        "\n",
        "    ax.plot(\n",
        "        subset[\"training_pairs\"],\n",
        "        subset[\"peak_step\"],\n",
        "        marker=\"o\",\n",
        "        linewidth=2,\n",
        "        label=model_name\n",
        "    )\n",
        "\n",
        "ax.set_xscale(\"log\")\n",
        "ax.set_title(\"Over-Optimization Peak vs Preference Dataset Size\")\n",
        "ax.set_xlabel(\"Number of training preference pairs (log scale)\")\n",
        "ax.set_ylabel(\"Policy step at maximum true utility\")\n",
        "ax.grid(True, alpha=0.3)\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "peak_path = os.path.join(OUTPUT_DIR, \"peak_movement.png\")\n",
        "plt.savefig(peak_path, dpi=160, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "# ----------------------------\n",
        "# 13. Diagnose which features are exploited\n",
        "# ----------------------------\n",
        "\n",
        "exploit_features = [\n",
        "    \"verbosity\",\n",
        "    \"keyword_stuffing\",\n",
        "    \"repetition\",\n",
        "    \"formatting\",\n",
        "    \"genuine_quality\"\n",
        "]\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
        "\n",
        "for key, history in all_histories.items():\n",
        "    axes[0].plot(\n",
        "        history[\"step\"],\n",
        "        history[\"keyword_stuffing\"],\n",
        "        label=key\n",
        "    )\n",
        "    axes[1].plot(\n",
        "        history[\"step\"],\n",
        "        history[\"genuine_quality\"],\n",
        "        label=key\n",
        "    )\n",
        "\n",
        "axes[0].set_title(\"Keyword Stuffing vs Optimization\")\n",
        "axes[0].set_xlabel(\"Policy optimization step\")\n",
        "axes[0].set_ylabel(\"Keyword-stuffing feature\")\n",
        "axes[0].grid(True, alpha=0.3)\n",
        "\n",
        "axes[1].set_title(\"Genuine Quality vs Optimization\")\n",
        "axes[1].set_xlabel(\"Policy optimization step\")\n",
        "axes[1].set_ylabel(\"Genuine-quality feature\")\n",
        "axes[1].grid(True, alpha=0.3)\n",
        "\n",
        "axes[0].legend(fontsize=7)\n",
        "axes[1].legend(fontsize=7)\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "exploit_path = os.path.join(OUTPUT_DIR, \"exploit_diagnosis.png\")\n",
        "plt.savefig(exploit_path, dpi=160, bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "# ----------------------------\n",
        "# 14. Generate an automatic report\n",
        "# ----------------------------\n",
        "\n",
        "report_path = os.path.join(OUTPUT_DIR, \"experiment_report.txt\")\n",
        "\n",
        "with open(report_path, \"w\", encoding=\"utf-8\") as f:\n",
        "    f.write(\"REWARD MODEL OVER-OPTIMIZATION EXPERIMENT\\n\")\n",
        "    f.write(\"=\" * 60 + \"\\n\\n\")\n",
        "\n",
        "    f.write(\"Methodology\\n\")\n",
